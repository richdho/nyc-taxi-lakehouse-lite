# Copy to .env for local overrides
LAKEHOUSE_PROFILE=local
LAKEHOUSE_ROOT=./lake
# Phase 1 bronze — yellow taxi (inclusive YYYY-MM)
TLC_YELLOW_START=2024-01
TLC_YELLOW_END=2024-01
# Do not set DAGSTER_HOME here — Dagster requires an absolute path, and uv loads
# .env before dagster starts. Use .\make.ps1 dagster (sets it automatically).
